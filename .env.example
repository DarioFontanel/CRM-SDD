# Copia questo file in ".env" e riempi i valori. Il file ".env" non va mai in git.

# Il ponte: progetto Supabase dedicato al CRM (vedi supabase/ponte.sql)
SUPABASE_URL=
# Chiave segreta: la usa il CRM per leggere e cancellare le righe del ponte
SUPABASE_SECRET_KEY=
# Chiave pubblicabile: la usa solo "pnpm invii-di-prova", come farà il sito
SUPABASE_PUBLISHABLE_KEY=

# Cal.com: chiave API per leggere le prenotazioni
CALCOM_API_KEY=
